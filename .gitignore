# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data (never commit large data)
# `data/*` chứ không phải `data/`: git không cho re-include file khi cả thư mục
# cha đã bị loại. `.gitkeep` phải có mặt vì SQLite không tự tạo thư mục cha
# (ADR-011 §Hệ quả).
data/*
!data/.gitkeep

# Ảnh chụp và snapshot của playwright-cli — rác công cụ, không phải của dự án.
.playwright-cli/
*.db
*.sqlite3

# Logs
logs/
*.log

# Chỗ nháp cá nhân — không bao giờ track.
scratch/

# Test coverage
htmlcov/
.coverage
coverage.xml

# Docker
docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
out/
.nuxt/

# Build
*.pyc
*.pyo

# AI logs — tracked structure, ignored content
.ai-log/*.jsonl
.ai-log/archive/

# Local-only presentation documents
# overview.html là BẢN TRÌNH BÀY dạng HTML để đọc và demo — nội dung của nó bám
# theo thiết kế hiện tại (kiểm 12/8: dùng ODDQuery/ODDCell, sudden_brake, SQLite
# BLOB, 4 ScenarioStatus của ADR-011; nhắc Qdrant và Isaac Sim ĐÚNG một lần mỗi
# thứ, ở bảng "đề gợi ý vs quyết định thực tế").
#
# Giữ local KHÔNG phải vì nó lỗi thời, mà vì repo chỉ được có MỘT tài liệu kiến
# trúc tracked: ARCHITECTURE.md. Track thêm file này là dựng tài liệu thứ hai
# chồng lấn — đúng thứ ADR-013 §Bối cảnh đã phải viết ADR để dọn.
#
# Luật: mọi thiết kế trong đây phải có bản tracked ở ARCHITECTURE.md hoặc ADR
# trước. File này chỉ được trình bày lại, không được giữ độc quyền quyết định nào.
# Đã chuyển đi: ví dụ từng node (→ §Ví dụ từng node), lộ trình 4 phase và mô hình
# retail/wholesale (→ §Lộ trình bốn phase, §Hai chế độ sinh), hai ràng buộc batch
# (→ ADR-014).
/docs/overview.html
