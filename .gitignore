# OS
.DS_Store
Thumbs.db

# Data (never commit large data)
# `data/*` chứ không phải `data/`: git không cho re-include file khi cả thư mục
# cha đã bị loại. `.gitkeep` phải có mặt vì SQLite không tự tạo thư mục cha
# (ADR-011 §Hệ quả).
data/*
!data/.gitkeep

# Ảnh chụp và snapshot của playwright-cli — rác công cụ, không phải của dự án.
.playwright-cli/
*.db
*.sqlite3
*.rdb

# Logs
logs/
*.log

# Chỗ nháp cá nhân — không bao giờ track.
scratch/

# Test coverage
htmlcov/
.coverage
coverage.xml

# Docker
docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
out/
.nuxt/

# Build
*.pyc
*.pyo

# AI logs — tracked structure, ignored content
.ai-log/*.jsonl
.ai-log/archive/

# Tài liệu HTML trình bày lại của Scenario Forge (đã gỡ, ADR-032) có thể còn trên máy cũ —
# giữ local, không track.
/docs/overview.html
/docs/scenario-forge-eli5.html

# Output của ScenarioRunner trên máy worker — log và JSON criteria mỗi lần chạy.
worker/outputs/
scripts/env_local.sh

# Báo cáo tuần — giữ local.
/Weekly report *.txt

# graphify: đồ thị tri thức sinh tự động (~9 MB), dựng lại bằng /graphify
graphify-out/

# Cấu hình Claude Code riêng từng máy (hook graphify dùng đường dẫn tuyệt đối)
.claude/
CLAUDE.local.md

