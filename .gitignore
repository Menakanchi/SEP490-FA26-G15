docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
out/
.nuxt/

# Build
*.pyc
*.pyo

# AI logs — tracked structure, ignored content
.ai-log/*.jsonl
.ai-log/archive/

# Local-only presentation documents
# overview.html là BẢN TRÌNH BÀY dạng HTML để đọc và demo — nội dung của nó bám
# theo thiết kế hiện tại (kiểm 12/8: dùng ODDQuery/ODDCell, sudden_brake, SQLite
# BLOB, 4 ScenarioStatus của ADR-011; nhắc Qdrant và Isaac Sim ĐÚNG một lần mỗi
# thứ, ở bảng "đề gợi ý vs quyết định thực tế").
#
# Giữ local KHÔNG phải vì nó lỗi thời, mà vì repo chỉ được có MỘT tài liệu kiến
# trúc tracked: ARCHITECTURE.md. Track thêm file này là dựng tài liệu thứ hai
# chồng lấn — đúng thứ ADR-013 §Bối cảnh đã phải viết ADR để dọn.
#
# Luật: mọi thiết kế trong đây phải có bản tracked ở ARCHITECTURE.md hoặc ADR
# trước. File này chỉ được trình bày lại, không được giữ độc quyền quyết định nào.
# Đã chuyển đi: ví dụ từng node (→ §Ví dụ từng node), lộ trình 4 phase và mô hình
# retail/wholesale (→ §Lộ trình bốn phase, §Hai chế độ sinh), hai ràng buộc batch
# (→ ADR-014).
/docs/overview.html

# scenario-forge-eli5.html cùng loại và cùng luật: trang HTML giải thích lại hệ
# thống cho người mới (đường ống 7 node, ma trận ODD, hai cổng duyệt, cách đọc
# kết quả CARLA). Mọi thứ trong đó đã có bản tracked ở ARCHITECTURE.md, ADR,
# `schemas.py` và `eval/results/` — nó chỉ trình bày lại, không giữ độc quyền
# quyết định nào. Vì vậy giữ local, không track: một tài liệu kiến trúc tracked
# là ARCHITECTURE.md, và đã có bản đọc được ở Artifact.
/docs/scenario-forge-eli5.html

# Output của ScenarioRunner trên máy worker — log và JSON criteria mỗi lần chạy.
worker/outputs/
scripts/env_local.sh

# Tài liệu tuần và vật liệu dựng pitch deck — giữ local.
#
# `presentation/pitch_deck.pptx` và `.pdf` đã tracked; đó là hiện vật giao ra.
# Còn script dựng và thư mục hình thì không: `build_deck.py` sinh lại được từ
# số liệu trong `eval/results/`, và `figures/` là output của chính nó. Track cả
# ba là track cùng một nội dung ở hai dạng, rồi chúng lệch nhau.
/Weekly report *.txt
/presentation/build_deck.py
/presentation/figures/
