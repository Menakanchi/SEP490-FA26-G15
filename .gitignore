# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data (never commit large data)
# `data/*` chứ không phải `data/`: git không cho re-include file khi cả thư mục
# cha đã bị loại. `.gitkeep` phải có mặt vì SQLite không tự tạo thư mục cha
# (ADR-011 §Hệ quả).
data/*
!data/.gitkeep

# Ảnh chụp và snapshot của playwright-cli — rác công cụ, không phải của dự án.
.playwright-cli/
*.db
*.sqlite3

# Logs
logs/
*.log

# Test coverage
htmlcov/
.coverage
coverage.xml

# Docker
docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
out/
.nuxt/

# Build
*.pyc
*.pyo

# AI logs — tracked structure, ignored content
.ai-log/*.jsonl
.ai-log/archive/

# Local-only planning documents
# overview.html là bản nháp của một thế hệ thiết kế trước (ParsedIntent,
# hard_brake, Qdrant, Isaac Sim) — giữ local, KHÔNG phải nguồn sự thật.
# Ví dụ từng node đã chuyển vào ARCHITECTURE.md §Ví dụ từng node.
/docs/overview.html
