# ============================================
# Scenario Forge (RAV-03) — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# openai | deepseek. Model mặc định đi theo provider (openai: gpt-5.4-mini/gpt-5.4,
# deepseek: deepseek-flash/deepseek-v4-pro); đặt MODEL_NAME / ESCALATED_MODEL để đổi.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# DeepSeek không có embeddings: retrieval vẫn cần OPENAI_API_KEY, không có thì
# rơi về vector theo hash (chỉ còn lọc theo 4 trục ODD là có nghĩa).
# DeepSeek bắt buộc LLM_REASONING_EFFORT=none (mặc định) — xem src/config.py.
DEEPSEEK_API_KEY=
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database: user · review · job · trạng thái scenario ----
# ADR-011: SQLite cho local/test/CI. Bản deploy có Live URL phải dùng Supabase
# PostgreSQL — Render free có filesystem ephemeral, file SQLite bị xoá mỗi lần
# redeploy hoặc wake-up. KHÔNG dùng Render Postgres free: hết hạn sau 30 ngày.
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ---- MySQL VehicSim (docker compose service `mysql`) ----
# Schema ở database/mysql/. Hiện chỉ phần xác thực (src/services/auth) dùng DB
# này; DATABASE_URL ở trên vẫn trỏ SQLite của Forge cho phần còn lại.
MYSQL_ROOT_PASSWORD=vehicsim_root
MYSQL_USER=vehicsim
MYSQL_PASSWORD=vehicsim
VEHICSIM_DATABASE_URL=mysql+pymysql://vehicsim:vehicsim@localhost:3306/vehicsim

# ---- Xác thực: JWT + OTP email 6 số (Redis) ----
# BẮT BUỘC đặt ở production, ví dụ: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Để trống ở development thì mỗi lần khởi động dùng một khoá ngẫu nhiên
# (mọi phiên đăng nhập mất sau restart).
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=60
REDIS_URL=redis://localhost:6379/0
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Chạy mô phỏng VehicSim (ADR-023, ADR-027) ----
# celery: worker Celery chạy run; inline: chạy ngay trong process API (test, dev nhanh).
VEHICSIM_RUN_MODE=celery
CELERY_BROKER_URL=redis://localhost:6379/1
# Trần một run (giây). CARLA nạp map + chạy thời gian thực nên cần lớn hơn, vd. 300.
SIMULATION_TIMEOUT_S=120
# kinematic: bộ động học, máy nào cũng chạy. carla: worker gọi CLI CARLA bằng tiến trình con.
VEHICSIM_SIMULATOR=kinematic
# Chỉ dùng khi VEHICSIM_SIMULATOR=carla — JSON list, backend nối thêm <bundle> --out <dir> --fast:
# VEHICSIM_CARLA_COMMAND=["/home/<user>/code/P-130/worker/.venv/bin/python","worker/run_variant.py","--map","Town05"]
VEHICSIM_CARLA_COMMAND=[]
# Phiên bản server CARLA mà run mới yêu cầu (server báo khác thì run FAILED).
VEHICSIM_CARLA_VERSION=0.9.15
# Thư mục chứa bundle/result/video của từng run CARLA (đã nằm trong data/, git bỏ qua).
VEHICSIM_DATA_ROOT=./data/vehicsim

# Không có biến vector store: ADR-013 chốt embedding nằm cùng DATABASE_URL
# dưới dạng BLOB, không có service riêng để trỏ tới.

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (Deliverable #4) ----
# ⚠ TOKEN LÀ CỦA RIÊNG TỪNG NGƯỜI — không dùng chung được.
# Khoá dùng chung mà chương trình phát ban đầu ĐÃ HẾT HIỆU LỰC:
# server trả về 401 "Personal access token required" (kiểm chứng 29/7).
#
# Lấy token của bạn:
#   1. Vào https://phoenix.note.transformerlabs.ai/api-keys
#   2. + New token  → đặt tên máy → COPY NGAY (chỉ hiện một lần)
#   3. Dán vào AI_LOG_API_KEY dưới đây
#   4. bash scripts/setup_hooks.sh
#   5. git push  → thấy "Submitted N entries → 202" là xong
#
# Log CHỈ được nộp khi `git push`. Làm cả ngày mà không push = không có bằng chứng.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=dan-personal-access-token-cua-ban-vao-day
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- SMTP Email Configuration ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@scenarioforge.ai
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="Scenario Forge ADAS"
SMTP_FROM_EMAIL=noreply@scenarioforge.ai
SMTP_USE_TLS=true
