# ============================================
# Scenario Forge (RAV-03) — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database: user · review · job · trạng thái scenario ----
# ADR-011: SQLite cho local/test/CI. Bản deploy có Live URL phải dùng Supabase
# PostgreSQL — Render free có filesystem ephemeral, file SQLite bị xoá mỗi lần
# redeploy hoặc wake-up. KHÔNG dùng Render Postgres free: hết hạn sau 30 ngày.
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Không có biến vector store: ADR-013 chốt embedding nằm cùng DATABASE_URL
# dưới dạng BLOB, không có service riêng để trỏ tới.

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (Deliverable #4) ----
# ⚠ TOKEN LÀ CỦA RIÊNG TỪNG NGƯỜI — không dùng chung được.
# Khoá dùng chung mà chương trình phát ban đầu ĐÃ HẾT HIỆU LỰC:
# server trả về 401 "Personal access token required" (kiểm chứng 29/7).
#
# Lấy token của bạn:
#   1. Vào https://phoenix.note.transformerlabs.ai/api-keys
#   2. + New token  → đặt tên máy → COPY NGAY (chỉ hiện một lần)
#   3. Dán vào AI_LOG_API_KEY dưới đây
#   4. bash scripts/setup_hooks.sh
#   5. git push  → thấy "Submitted N entries → 202" là xong
#
# Log CHỈ được nộp khi `git push`. Làm cả ngày mà không push = không có bằng chứng.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=dan-personal-access-token-cua-ban-vao-day
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- SMTP Email Configuration ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@scenarioforge.ai
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="Scenario Forge ADAS"
SMTP_FROM_EMAIL=noreply@scenarioforge.ai
SMTP_USE_TLS=true
