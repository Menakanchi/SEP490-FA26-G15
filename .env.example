# ============================================
# VehicSim (SEP490-FA26-G15) — Environment Variables
# ============================================
# Copy this file to .env (thư mục gốc repo) and fill in your values.
# Backend Spring Boot tự đọc ./.env khi chạy từ thư mục gốc; docker compose dùng nó qua env_file.
# NEVER commit .env to git!
# Biến nào không đặt thì dùng mặc định trong src/main/resources/application.yml.

# ---- LLM Configuration ----
# openai | deepseek. Model mặc định đi theo provider (openai: gpt-5.4-mini/gpt-5.4,
# deepseek: deepseek-flash/deepseek-v4-pro); đặt MODEL_NAME / ESCALATED_MODEL để đổi.
# Chỉ bước "Sinh từ mô tả" gọi LLM; thiếu khoá thì lùi về bộ luật không tốn tiền.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
DEEPSEEK_API_KEY=
# MODEL_NAME=
# ESCALATED_MODEL=
# DeepSeek bắt buộc LLM_REASONING_EFFORT=none (mặc định).
# LLM_REASONING_EFFORT=none
# LLM_TEMPERATURE=0.7

# ---- Database duy nhất: MySQL (docker compose service `mysql`) ----
# Schema ở database/mysql/01_schema.sql, nâng DB cũ bằng database/mysql/migrations/.
# MYSQL_* dùng cho container mysql; backend nối bằng SPRING_DATASOURCE_* (mặc định vehicsim/vehicsim ở localhost:3306).
MYSQL_ROOT_PASSWORD=vehicsim_root
MYSQL_USER=vehicsim
MYSQL_PASSWORD=vehicsim
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/vehicsim?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=vehicsim
# SPRING_DATASOURCE_PASSWORD=vehicsim
# Redis: mã OTP, bộ đếm nhập sai, giới hạn tần suất.
# SPRING_REDIS_HOST=localhost
# SPRING_REDIS_PORT=6379

# ---- Xác thực: JWT + OTP email 6 số (Redis) ----
# JWT_SECRET: khoá HMAC dạng Base64, tối thiểu 256 bit. BẮT BUỘC ở production (APP_ENV=production):
# thiếu thì backend không khởi động. Sinh khoá:  openssl rand -base64 48
# Để trống ở development thì dùng khoá mặc định CÔNG KHAI trong repo — chỉ an toàn trên máy dev.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=60
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Giới hạn tần suất (cửa sổ RATE_LIMIT_WINDOW_SECONDS, theo IP trừ khi ghi chú khác).
RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_ATTEMPTS_PER_IP=10
LOGIN_ATTEMPTS_PER_ACCOUNT=20
OTP_REQUESTS_PER_IP=5
REGISTER_REQUESTS_PER_IP=10
# Cách đăng ký (TD-35): auto | one_step | otp. auto = production dùng otp (email -> mã 6 số, cần SMTP_* bên dưới),
# còn lại dùng one_step (tạo tài khoản luôn, KHÔNG xác minh email — chỉ hợp ở máy dev). Đặt otp thì phải có SMTP.
REGISTRATION_MODE=auto
# Đứng sau reverse proxy / Cloudflare (TD-36): đặt native để giới hạn đăng nhập / OTP tính theo IP thật của client thay vì IP của proxy.
# Tomcat chỉ tin X-Forwarded-For từ proxy tin cậy (mặc định các dải IP nội bộ; chỉnh bằng SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES).
# Không đứng sau proxy thì để none — nếu không, ai cũng giả được IP bằng header.
FORWARD_HEADERS_STRATEGY=none

# ---- Chạy mô phỏng VehicSim (ADR-023, ADR-027, ADR-039) ----
# async: thread pool của backend (mặc định); inline: chạy ngay trong request (test, dev nhanh).
VEHICSIM_RUN_MODE=async
# Số run song song của bộ động học (CARLA luôn 1).
# VEHICSIM_RUN_CONCURRENCY=4
# Python >= 3.10 và thư mục worker cho bộ động học (tiến trình con python worker/kinematic_sim.py).
# VEHICSIM_WORKER_PYTHON=python
# VEHICSIM_WORKER_DIR=worker
# Trần một run (giây). CARLA nạp map + chạy thời gian thực nên cần lớn hơn, vd. 300.
SIMULATION_TIMEOUT_S=120
# kinematic: bộ động học. carla: runner JSON cũ. carla-xosc: ScenarioRunner chạy .xosc.
# Windows CARLA 0.9.16: scripts/setup-carla.ps1 rồi scripts/dev-carla.ps1 -RestartBackend (không cần sửa .env).
VEHICSIM_SIMULATOR=kinematic
# Lệnh worker CARLA, JSON list; backend nối <bundle.json hoặc scenario.xosc> --out <dir> --fast:
# VEHICSIM_CARLA_COMMAND=["<repo>/worker/.venv/bin/python","worker/run_variant.py","--map","Town05"]
VEHICSIM_CARLA_COMMAND=
# Phiên bản server CARLA mà run mới yêu cầu (server báo khác thì run FAILED).
VEHICSIM_CARLA_VERSION=0.9.15
# Thư mục chứa bundle/result/video của từng run CARLA (đã nằm trong data/, git bỏ qua).
VEHICSIM_DATA_ROOT=./data/vehicsim
# Nhặt lại run PENDING/RUNNING bỏ dở khi khởi động.
# VEHICSIM_RECOVER_ON_STARTUP=true
# Chống lạm dụng khi mở đăng ký công khai: số lần tạo họ / candidate / regression mỗi người trong một cửa sổ,
# và số run đang chờ + đang chạy tối đa của một người.
# VEHICSIM_WRITES_PER_WINDOW=30
# VEHICSIM_MAX_ACTIVE_RUNS_PER_USER=1500

# ---- App Config ----
# development | production. Production: bắt buộc JWT_SECRET, không ghi OTP vào log, tắt Swagger UI / OpenAPI.
APP_ENV=development
# Cổng backend (mặc định 8001):  SERVER_PORT=8001
# Origin của frontend được gọi API (CORS), phân tách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- AI Hook Logging (Deliverable #4) ----
# ⚠ TOKEN LÀ CỦA RIÊNG TỪNG NGƯỜI — không dùng chung được.
# Khoá dùng chung mà chương trình phát ban đầu ĐÃ HẾT HIỆU LỰC:
# server trả về 401 "Personal access token required" (kiểm chứng 29/7).
#
# Lấy token của bạn:
#   1. Vào https://phoenix.note.transformerlabs.ai/api-keys
#   2. + New token  → đặt tên máy → COPY NGAY (chỉ hiện một lần)
#   3. Dán vào AI_LOG_API_KEY dưới đây
#   4. bash scripts/setup_hooks.sh
#   5. git push  → thấy "Submitted N entries → 202" là xong
#
# Log CHỈ được nộp khi `git push`. Làm cả ngày mà không push = không có bằng chứng.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=dan-personal-access-token-cua-ban-vao-day
AI_LOG_DIR=.ai-log

# ---- Frontend ----
# Đặt trong frontend/.env.local (không phải file này):
# NEXT_PUBLIC_API_URL=http://localhost:8001

# ---- SMTP Email Configuration (gửi mã OTP) ----
# Thiếu SMTP_USER / SMTP_PASSWORD thì không gửi; ngoài production mã được ghi vào log backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-account@gmail.com
