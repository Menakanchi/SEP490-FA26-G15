{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "cd \"$(git rev-parse --show-toplevel)\" && bash scripts/_pyrun.sh scripts/log_hook.py --tool=cursor"
      }
    ],
    "stop": [
      {
        "command": "cd \"$(git rev-parse --show-toplevel)\" && bash scripts/_pyrun.sh scripts/log_hook.py --tool=cursor"
      }
    ]
  }
}
