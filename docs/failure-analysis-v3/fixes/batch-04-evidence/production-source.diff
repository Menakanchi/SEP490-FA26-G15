+                if(in.getFilePointer()>offset+size)bad("ZIP_DIRECTORY_TRUNCATED",name);
+            }
+            if(in.getFilePointer()!=offset+size)bad("ZIP_DIRECTORY_COUNT_MISMATCH",source);
