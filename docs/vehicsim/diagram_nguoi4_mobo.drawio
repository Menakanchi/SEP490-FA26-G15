<mxfile host="Electron" modified="2026-11-12T01:00:00.000Z" agent="Antigravity" version="32.6.10">
  <diagram id="mobo-architecture" name="Luồng Tối ưu MOBO - Người 4">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Tiêu đề -->
        <mxCell id="title" value="QUY TRÌNH TỐI ƯU HÓA THAM SỐ AEB BẰNG MOBO (NGƯỜI 4 — PHUONGNA)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="670" height="40" as="geometry" />
        </mxCell>

        <!-- Bước 1: Đầu vào từ Màn 3 -->
        <mxCell id="step1" value="ĐẦU VÀO TỪ MÀN 3&#xa;(Phân tích lỗi &amp; Dataset v2)&#xa;• Bộ tình huống kiểm thử&#xa;• Cấu hình AEB Baseline&#xa;• Seed kịch bản" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- Mũi tên 1 -> 2 -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bước 2: Thiết lập ngân sách & Khởi tạo -->
        <mxCell id="step2" value="CẤU HÌNH CHIẾN DỊCH (Frontend /aeb)&#xa;• Ngân sách: max_trials, n_initial_points&#xa;• 4 Tham số: TTC_THRESHOLD, DELAY,&#xa;  MAX_DECELERATION, BUILDUP_RATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="260" height="100" as="geometry" />
        </mxCell>

        <!-- Mũi tên 2 -> 3 -->
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bước 3: Vòng lặp MOBO Engine -->
        <mxCell id="step3" value="LÕI THUẬT TOÁN MOBO (MoboEngine)&#xa;1. Khởi tạo: Bounded Random Sampling (n &lt; nInitial)&#xa;2. Surrogate: 3 Gaussian Process độc lập&#xa;3. Acquisition: qEHVI (Monte Carlo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#92400E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="90" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- Mũi tên 3 -> 4 (Đề xuất) -->
        <mxCell id="arrow3" value="Đề xuất Candidate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#F59E0B;fontColor=#92400E;fontStyle=1;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Bước 4: Đánh giá bằng Simulator -->
        <mxCell id="step4" value="ĐÁNH GIÁ 3 MỤC TIÊU (Java Core Simulator)&#xa;• Mục tiêu 1: Cực tiểu RMS Jerk (Độ êm)&#xa;• Mục tiêu 2: Cực tiểu Vận tốc va chạm&#xa;• Mục tiêu 3: Cực tiểu Quãng phanh dừng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#065F46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="300" width="280" height="100" as="geometry" />
        </mxCell>

        <!-- Mũi tên phản hồi (Loop back) -->
        <mxCell id="arrowLoop" value="Cập nhật Trial &amp; Lặp lại&#xa;(nếu chưa đạt max_trials)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#EF4444;fontColor=#B91C1C;dashed=1;" edge="1" parent="1" source="step4" target="step3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="350" />
              <mxPoint x="980" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Mũi tên 4 -> 5 (Hoàn tất) -->
        <mxCell id="arrow4" value="Khi hoàn tất ngân sách" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#10B981;fontColor=#065F46;fontStyle=1;" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="470" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Bước 5: Tập nghiệm Pareto -->
        <mxCell id="step5" value="TẬP NGHIỆM TỐI ƯU PARETO FRONT&#xa;• Trích xuất các trials không bị lấn át&#xa;• Hiển thị đồ thị đánh đổi (Trade-off) trên UI&#xa;• Kỹ sư chọn 1 Candidate ưng ý nhất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#3730A3;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="440" width="260" height="110" as="geometry" />
        </mxCell>

        <!-- Mũi tên 5 -> 6 -->
        <mxCell id="arrow5" value="Bấm 'Chuyển sang xác minh'" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6366F1;fontColor=#3730A3;fontStyle=1;" edge="1" parent="1" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bước 6: Bàn giao sang Người 5 -->
        <mxCell id="step6" value="BÀN GIAO SANG NGƯỜI 5&#xa;(Kiểm thử hồi quy &amp; Phê duyệt)&#xa;• Chạy Regression test cùng seed baseline&#xa;• Reviewer xem xét và bấm ACCEPT/REJECT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="220" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
